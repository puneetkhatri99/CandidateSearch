# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/candidate_search
# Hosted (e.g. Neon): use the direct host, not "-pooler", and ?ssl=require (asyncpg doesn't
# understand sslmode / channel_binding).
# Tests and e2e empty their database. Required when DATABASE_URL isn't local; otherwise
# they use <DATABASE_URL's database>_test.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/candidate_search_test
CORS_ORIGINS=["http://localhost:5180"]

# Embeddings (Phase 2). OpenAI is the only provider. Without a real key, saves still work but
# nothing is embedded until a key is set and the API restarts.
OPENAI_API_KEY=sk-CHANGE_ME
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(1536) column created by the migration.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
# How often the API looks for new or edited candidates and jobs to embed.
EMBEDDING_POLL_SECONDS=2

# ResumeAI: reads uploaded resumes and renders the formatted resume PDF. Server-side only;
# never put this key in the frontend. Without it, resume upload and "See resume" answer 503.
RESUMEAI_API_KEY=CHANGE_ME
RESUMEAI_BASE_URL=https://ai-resume-data-extractor.onrender.com
RESUMEAI_TIMEOUT_SECONDS=120
# Public form uploads per IP per window; ResumeAI allows 30 reads an hour from our server.
RESUME_UPLOAD_LIMIT=10
RESUME_UPLOAD_WINDOW_SECONDS=3600
MAX_RESUME_BYTES=4194304

# S3-compatible storage (Neon object storage) for the formatted resume PDFs. Neon's
# `neon env pull --service object-storage` writes the four AWS_* values. Leave the bucket or keys
# empty and "See resume" asks ResumeAI every time instead.
RESUME_BUCKET=resume
AWS_ENDPOINT_URL_S3=https://CHANGE_ME.storage.c-8.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# Background tasks inside the API: embedding, and pruning rate-limit hits and expired sessions.
# Set false to run `python -m app.cli maintenance` as its own process instead.
MAINTENANCE_IN_API=true
# Serverless (Vercel): MAINTENANCE_IN_API=false, EMBED_ON_SAVE=true, and a CRON_SECRET for the
# daily maintenance route. See scripts/deploy-vercel.ps1.
EMBED_ON_SAVE=false
# CRON_SECRET=change-me-to-a-long-random-string

# HMAC key for rate-limit keys (no raw emails or IPs are stored). Optional in local/test (a
# built-in development value is used); required in staging/production: 32+ random characters,
# identical in every API process. Rotating it resets all limits.
# RATE_LIMIT_KEY_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Per-admin limit on creating accounts and resetting passwords (each runs argon2).
ADMIN_ACCOUNT_WRITE_LIMIT=20
ADMIN_ACCOUNT_WRITE_WINDOW_SECONDS=3600
